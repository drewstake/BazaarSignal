# Public Firebase client values for the EXISTING BazaarSignal project.
# npm run dev rejects a different project. Obtain all four values from the
# maintainer; this file alone does not enable sign-in. See docs/development.md.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Versioned Apps Script endpoint, executing as the configured sender.
# npm run dev uses the local notification adapter instead (no email delivery).
VITE_APPS_SCRIPT_URL=

# Test harnesses set true with demo-bazaar-watch, Auth 9098 / Firestore 8081.
# Signed-in local development overrides false: real Auth, local Firestore.
VITE_USE_EMULATORS=false
VITE_LOCAL_MARKET_PREVIEW=false

# Production shared market HTTPS origin; no browser Hypixel fallback.
# Local launchers override these via scripts/local-market-config.mjs.
# dev:preview disables sign-in; --offline reads saved SQLite data (may be empty).
VITE_MARKET_API_URL=
VITE_PRICE_HISTORY_URL=
VITE_MARKET_UPDATES_PAUSED=true
VITE_MARKET_OPERATING_MODE=trial
VITE_MARKET_TRIAL_END=
VITE_MARKET_TRIAL_ID=

# Server-only settings never belong in VITE_* variables. Local launchers disable
# collection and email. See collector/.env.example and docs/development.md.
# PRICE_HISTORY_FILE=.local/price-history.sqlite
# MARKET_CACHE_FILE=.local/current-market.sqlite
# MARKET_SCHEDULER_DISABLED=1
