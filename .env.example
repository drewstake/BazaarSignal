VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Use local during development while the cloud backend is being configured.
# Change to firebase after deploying the backend. Production ignores local.
VITE_APP_MODE=local
# Enable only after owner access and the deployed backend are configured.
VITE_BACKEND_READY=false
# Versioned Apps Script web app, executing as bazaarsignal@gmail.com.
VITE_APPS_SCRIPT_URL=
# Leave Firebase config empty for local live prices (or ?demo=1 for fixtures).
# Set true only when explicitly testing local Firebase emulators.
VITE_USE_EMULATORS=false

# Required production shared market HTTPS origin (no trailing /api path).
# No browser Hypixel fallback. Configure a host/store before deploying.
# Development uses the scheduled local collector and a persistent SQLite cache.
VITE_MARKET_API_URL=
# Production defaults to paused. Reviewed free-tier mode uses hourly collection
# and a fixed period (at most 32 days); ordinary trials remain at most 15 minutes.
# Enabling flags alone does not initialize the server's durable allowance ledger.
VITE_MARKET_UPDATES_PAUSED=true
VITE_MARKET_OPERATING_MODE=trial
VITE_MARKET_TRIAL_END=
VITE_MARKET_TRIAL_ID=
# The deployed collector and API must use the same immutable identity/deadline.
# MARKET_TRIAL_ID, MARKET_TRIAL_START and MARKET_TRIAL_END belong in the reviewed
# Functions release configuration, not a manually enabled production flag.
# Free-tier server releases use MARKET_OPERATING_MODE=free-tier plus
# MARKET_LIVE_ID and MARKET_LIVE_END. See docs/FREE-TIER-LIVE-DEPLOYMENT.md.

# SERVER ONLY: set in the host/service environment, never VITE_* variables.
# Multi-host deployments: all instances must share the same Redis service.
# MARKET_REDIS_URL=rediss://...
# Single host: share ONE absolute persistent LOCAL file across processes.
# MARKET_STORE=sqlite
# MARKET_CACHE_FILE=/var/lib/bazaarsignal/current-market.sqlite
# HYPIXEL_REQUEST_LIMIT=120
# HYPIXEL_WINDOW_MS=300000
# HYPIXEL_RESERVE=0.20
# MARKET_BAZAAR_MS=60000
# MARKET_AUCTION_MIN_MS=120000
# MOJANG_REQUESTS_PER_MINUTE=30
# COLLECTOR_ALLOWED_ORIGINS=https://bazaarsignal.web.app
# COLLECTOR_HOST=127.0.0.1
# COLLECTOR_PORT=8787
# MARKET_SCHEDULER_DISABLED=1 disables collection in Vite fixture tests.
# Apps Script also defaults to paused; MARKET_UPDATES_PAUSED in Script Properties
# stays absent/true unless a reviewed period is explicitly enabled. Grants also
# require MARKET_TRIAL_START and MARKET_TRIAL_END; free-tier mode permits 32 days.
