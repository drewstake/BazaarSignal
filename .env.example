VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Use local during development while the cloud backend is being configured.
# Change to firebase after deploying the backend. Production ignores local.
VITE_APP_MODE=local
# Enable only after owner access and the deployed backend are configured.
VITE_BACKEND_READY=false
# Versioned Apps Script web app, executing as bazaarsignal@gmail.com.
VITE_APPS_SCRIPT_URL=
# Leave Firebase config empty for local live prices (or ?demo=1 for fixtures).
# Set true only when explicitly testing local Firebase emulators.
VITE_USE_EMULATORS=false

# Shared collector HTTPS origin in production (no trailing /api path).
# Development uses the shared Vite collector automatically.
VITE_MARKET_API_URL=
