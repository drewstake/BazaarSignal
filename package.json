{
  "name": "bazaar-watch",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "functions"
  ],
  "overrides": {
    "gaxios": {
      "uuid": "^11.1.1"
    }
  },
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "dev:local": "node scripts/dev-local.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "dev:preview": "node scripts/dev-preview.mjs",
    "dev:preview:offline": "node scripts/dev-preview.mjs --offline",
    "backup:local": "node scripts/backup-local.mjs",
    "history:import": "esbuild scripts/import-price-history.ts --bundle --platform=node --format=esm --packages=external --outfile=.local/import-price-history.mjs && node .local/import-price-history.mjs",
    "history:collect": "esbuild scripts/collect-daily-prices.ts --bundle --platform=node --format=esm --packages=external --outfile=.local/collect-daily-prices.mjs && node .local/collect-daily-prices.mjs",
    "history:backup": "esbuild scripts/backup-price-history.ts --bundle --platform=node --format=esm --packages=external --outfile=.local/backup-price-history.mjs && node .local/backup-price-history.mjs",
    "build": "tsc --noEmit && vite build && npm run build:backend",
    "test": "vitest run",
    "test:local": "vitest run --config vitest.local.config.ts",
    "collector": "node scripts/build-collector.mjs && node .local/collector-runner.mjs",
    "build:collector": "tsc --noEmit -p collector/tsconfig.json && node scripts/build-collector.mjs",
    "build:market-functions": "tsc --noEmit -p market-functions/tsconfig.json && node scripts/build-market-functions.mjs",
    "build:market-image": "npm run build:market-functions && node scripts/build-market-image.mjs",
    "trial:launch": "esbuild scripts/launch-market-trial.ts --bundle --platform=node --format=esm --packages=external --outfile=.local/launch-market-trial.mjs && node .local/launch-market-trial.mjs",
    "trial:local": "esbuild scripts/local-market-trial.ts --bundle --platform=node --format=esm --packages=external --outfile=.local/local-market-trial.mjs && node .local/local-market-trial.mjs",
    "measure:market": "esbuild scripts/measure-market.ts --bundle --platform=node --format=esm --packages=external --outfile=.local/measure-market.mjs && node .local/measure-market.mjs",
    "configure:market": "esbuild scripts/configure-market.ts --bundle --platform=node --format=esm --packages=external --outfile=.local/configure-market.mjs && node .local/configure-market.mjs",
    "test:private-browser": "npm run test:browser",
    "test:rules": "firebase emulators:exec --config firebase.test.json --only firestore --project demo-bazaar-watch \"vitest run --config vitest.rules.config.ts\"",
    "test:browser": "firebase emulators:exec --config firebase.test.json --only auth,firestore --project demo-bazaar-watch \"playwright test --config playwright.private.config.ts\"",
    "preview": "vite preview --host 127.0.0.1",
    "deploy:preview": "npm run build && firebase hosting:channel:deploy review",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy": "npm run build && firebase deploy --only hosting,firestore",
    "build:backend": "tsc --noEmit --project apps-script/tsconfig.json && node scripts/build-apps-script.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "fflate": "^0.8.3",
    "firebase": "^12.19.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "redis": "^5.12.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@google/clasp": "^3.4.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "esbuild": "^0.28.2",
    "firebase-tools": "^15.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
