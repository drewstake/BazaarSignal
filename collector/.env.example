# Standalone collector settings. Export in the process environment; not auto-loaded.
# See docs/operations/README.md before running operator commands.
COLLECTOR_HOST=127.0.0.1
COLLECTOR_PORT=8787
COLLECTOR_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MARKET_STORE=sqlite
MARKET_CACHE_FILE=.local/current-market.sqlite
# The current standalone entry point serves cached data and does not start collection.
# Optional shared store: set MARKET_REDIS_URL=rediss://... instead of local SQLite.
# Service credentials, when required, belong outside this repository.
